# RyThM Music application settings for www.rythmmusic.site.
# Copy to .env.production and replace every replace-with-* value.
MUSIC_PORT=8080
APP_SECRET=replace-with-at-least-32-random-characters
AUDIO_TERMS_VERSION=2026-07-30

VITE_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
AUDIO_TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

AUDIO_SMTP_HOST=replace-with-real-smtp-host
AUDIO_SMTP_PORT=587
AUDIO_SMTP_USERNAME=replace-with-smtp-user
AUDIO_SMTP_PASSWORD=replace-with-smtp-password
AUDIO_SMTP_FROM_EMAIL=noreply@rythmmusic.site

# The t4g.small baseline admits one analysis and keeps at most eight waiting.
AUDIO_MAX_AUDIO_DURATION_SEC=300
AUDIO_ANALYSIS_QUEUE_MAX_SIZE=8
AUDIO_ANALYSIS_QUEUE_WAIT_SECONDS=900
AUDIO_REGISTRATION_RATE_LIMIT_PER_HOUR=5
AUDIO_LOGIN_RATE_LIMIT_PER_TEN_MINUTES=5
AUDIO_VERIFICATION_RATE_LIMIT_PER_HOUR=10
AUDIO_EMAIL_ACTION_RATE_LIMIT_PER_HOUR=3
AUDIO_EMAIL_ACTION_IP_RATE_LIMIT_PER_HOUR=10

AUDIO_MUSIC_PROVIDER=demo
AUDIO_MUSIC_API_URL=
AUDIO_MUSIC_STATUS_URL=
AUDIO_MUSIC_API_KEY=
AUDIO_LLM_API_KEY=
AUDIO_LYRICS_API_URL=
AUDIO_LYRICS_API_KEY=
AUDIO_ANALYSIS_POINTS_COST=0
AUDIO_GENERATION_POINTS_COST=0
