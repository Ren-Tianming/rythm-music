AUDIO_APP_NAME=RyThM Music
AUDIO_ENVIRONMENT=development
APP_SECRET=development-only-change-me
AUDIO_LOG_LEVEL=INFO
AUDIO_DATABASE_URL=postgresql+psycopg://rythm_user:rythm_password@localhost:5432/rythm_music
AUDIO_REDIS_URL=redis://localhost:6379/0
AUDIO_FRONTEND_URL=http://localhost:8080
AUDIO_SESSION_COOKIE_NAME=rythm_session
AUDIO_CSRF_COOKIE_NAME=rythm_csrf
AUDIO_SESSION_IDLE_HOURS=24
AUDIO_SESSION_ABSOLUTE_DAYS=14
AUDIO_COOKIE_SECURE=false
AUDIO_COOKIE_SAMESITE=lax
AUDIO_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AUDIO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
AUDIO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
# Cloudflare Turnstile. Leave blank only for local development.
VITE_TURNSTILE_SITE_KEY=
AUDIO_TURNSTILE_SECRET_KEY=
AUDIO_TURNSTILE_REQUIRED=false
AUDIO_TURNSTILE_EXPECTED_HOSTNAMES=
# Email activation. Development logs the activation URL when SMTP is blank.
AUDIO_SMTP_HOST=
AUDIO_SMTP_PORT=587
AUDIO_SMTP_USERNAME=
AUDIO_SMTP_PASSWORD=
AUDIO_SMTP_FROM_EMAIL=noreply@example.com
AUDIO_SMTP_USE_TLS=true
AUDIO_UPLOAD_DIR=storage/uploads
AUDIO_GENERATED_DIR=storage/generated
AUDIO_RATE_LIMIT_REQUESTS=60
AUDIO_AUTH_RATE_LIMIT_REQUESTS=10
AUDIO_RATE_LIMIT_WINDOW_SECONDS=60
AUDIO_REGISTRATION_RATE_LIMIT_PER_HOUR=5
AUDIO_LOGIN_RATE_LIMIT_PER_TEN_MINUTES=5
AUDIO_VERIFICATION_RATE_LIMIT_PER_HOUR=10
AUDIO_EMAIL_ACTION_RATE_LIMIT_PER_HOUR=3
AUDIO_EMAIL_ACTION_IP_RATE_LIMIT_PER_HOUR=10
AUDIO_TERMS_VERSION=2026-07-30
AUDIO_PASSWORD_RESET_EXPIRE_MINUTES=30
AUDIO_ANALYSIS_MAX_CONCURRENCY=1
AUDIO_ANALYSIS_QUEUE_MAX_SIZE=8
AUDIO_ANALYSIS_QUEUE_WAIT_SECONDS=900
AUDIO_AUTO_CREATE_TABLES=false
AUDIO_ANALYSIS_POINTS_COST=0
AUDIO_GENERATION_POINTS_COST=0
# Trained Tonnetz ONNX classifier and ordered-label metadata.
AUDIO_GENRE_MODEL_PATH=backend/models/genre/genre-model.onnx
AUDIO_GENRE_MODEL_METADATA_PATH=backend/models/genre/genre-model.metadata.json
# Optional OpenAI-compatible LLM summary provider.
AUDIO_LLM_BASE_URL=https://api.openai.com/v1
AUDIO_LLM_API_KEY=
AUDIO_LLM_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible audio transcription endpoint.
AUDIO_LYRICS_API_URL=
AUDIO_LYRICS_API_KEY=
AUDIO_LYRICS_MODEL=whisper-1
# `demo` creates a short procedural WAV. Change this after adding a Suno-compatible provider.
AUDIO_MUSIC_PROVIDER=demo
AUDIO_MUSIC_API_URL=
AUDIO_MUSIC_STATUS_URL=
AUDIO_MUSIC_API_KEY=
