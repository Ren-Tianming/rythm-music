# Generate every password with: openssl rand -hex 32
# Keep the real deploy/shared-postgres.env file readable only by the deploy user.
POSTGRES_ADMIN_USER=rythm_admin
POSTGRES_ADMIN_PASSWORD=replace-with-64-hex-characters

MUSIC_POSTGRES_DB=rythm_music
MUSIC_POSTGRES_USER=rythm_music
MUSIC_POSTGRES_PASSWORD=replace-with-64-hex-characters

CHATBOT_POSTGRES_DB=rythm_chatbot
CHATBOT_POSTGRES_USER=rythm_chatbot
CHATBOT_POSTGRES_PASSWORD=replace-with-64-hex-characters
CHATBOT_PORT=8081
